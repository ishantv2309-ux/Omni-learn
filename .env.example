# OmniLearn Environment Configurations
# Copy this file to '.env' and fill in your details

# Database connection URL (defaults to SQLite: 'sqlite:///./omnilearn.db')
# For PostgreSQL: 'postgresql://user:password@host:port/dbname'
DATABASE_URL=sqlite:///./omnilearn.db

# Storage path for uploaded handwritten notes (PDFs/Images)
STORAGE_DIR=./storage/notes

# External API Keys (Leave empty to trigger automatic mock fallbacks)
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_KEY=

# Mock Mode Configuration (Optional)
# Options: "auto" (default, mock if key is missing), "true" (always mock), "false" (error if key missing)
MOCK_GEMINI=auto
MOCK_YOUTUBE=auto
MOCK_SEARCH=auto

# Server deployment configurations
PORT=8000
